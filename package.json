    "lucide-react": "^0.468.0",
    "manifold-3d": "3.5.3",
    "next": "16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "ts-fem": "https://codeload.github.com/janvorisek/ts-fem/tar.gz/b18694f42119de46c91cb37143896ca69e54d5a3"
